{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colibri-lite-rs.local/schemas/model-profile-v1.schema.json",
  "title": "colibri-lite model profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "profile_id", "created_at", "runtime", "model", "artifact", "execution", "quality_reference"],
  "properties": {
    "schema": {"const": "colibri-lite-model-profile-v1"}, "schema_version": {"const": 1},
    "profile_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["name", "commit", "target"], "properties": {"name": {"const": "colibri-lite-rs"}, "commit": {"type": "string", "minLength": 7}, "target": {"type": "string", "minLength": 1}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "architecture", "layers", "hidden_size", "vocabulary_size", "routing"], "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "architecture": {"type": "string", "minLength": 1}, "layers": {"type": "integer", "minimum": 1}, "hidden_size": {"type": "integer", "minimum": 1}, "vocabulary_size": {"type": "integer", "minimum": 1}, "routing": {"type": "object", "additionalProperties": false, "required": ["expert_count", "experts_per_token"], "properties": {"expert_count": {"type": "integer", "minimum": 1}, "experts_per_token": {"type": "integer", "minimum": 1}}}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["format", "format_version", "root_manifest_sha256", "storage_dtype", "dense", "experts"], "properties": {"format": {"type": "string", "minLength": 1}, "format_version": {"type": "integer", "minimum": 1}, "root_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "storage_dtype": {"type": "string", "minLength": 1}, "dense": {"$ref": "#/$defs/component"}, "experts": {"$ref": "#/$defs/expert_component"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["kv_cache", "precision_candidates", "estimated_bytes_per_routed_token"], "properties": {"kv_cache": {"type": "object", "additionalProperties": false, "required": ["bytes_per_token", "context_lengths"], "properties": {"bytes_per_token": {"type": "integer", "minimum": 1}, "context_lengths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}}}, "precision_candidates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "status", "weight_dtype"], "properties": {"candidate_id": {"type": "string", "minLength": 1}, "status": {"enum": ["accepted_reference", "candidate", "rejected", "insufficient_evidence"]}, "weight_dtype": {"type": "string", "minLength": 1}, "evidence": {"type": "string"}}}}, "estimated_bytes_per_routed_token": {"type": "integer", "minimum": 0}}},
    "quality_reference": {"type": "object", "additionalProperties": false, "required": ["reference_id", "manifest_sha256", "bilingual_fixture_manifest_sha256"], "properties": {"reference_id": {"const": "reference-f32-v1"}, "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bilingual_fixture_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"component": {"type": "object", "additionalProperties": false, "required": ["bytes", "tensor_count"], "properties": {"bytes": {"type": "integer", "minimum": 1}, "tensor_count": {"type": "integer", "minimum": 1}}}, "expert_component": {"type": "object", "additionalProperties": false, "required": ["bytes", "tensor_count", "logical_expert_count", "shard_count", "per_layer_payload_bytes"], "properties": {"bytes": {"type": "integer", "minimum": 1}, "tensor_count": {"type": "integer", "minimum": 1}, "logical_expert_count": {"type": "integer", "minimum": 1}, "shard_count": {"type": "integer", "minimum": 1}, "per_layer_payload_bytes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}}}}
}
