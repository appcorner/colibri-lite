{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colibri-lite-rs.local/schemas/planner-contract-v1.schema.json",
  "title": "colibri-lite placement planner contract v1",
  "$defs": {
    "non_negative_integer": {"type": "integer", "minimum": 0},
    "positive_integer": {"type": "integer", "minimum": 1},
    "positive_number": {"type": "number", "exclusiveMinimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "document_sha256"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "document_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "request_id", "hardware_profile", "model_profile", "workload", "compute_work", "budgets"],
      "properties": {
        "schema": {"const": "colibri-lite-planner-request-v1"},
        "schema_version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1},
        "hardware_profile": {"$ref": "#/$defs/profile_reference"},
        "model_profile": {"$ref": "#/$defs/profile_reference"},
        "workload": {
          "type": "object", "additionalProperties": false,
          "required": ["workload_id", "prefill_tokens", "decode_tokens", "context_tokens"],
          "properties": {
            "workload_id": {"type": "string", "minLength": 1},
            "prefill_tokens": {"$ref": "#/$defs/non_negative_integer"},
            "decode_tokens": {"$ref": "#/$defs/positive_integer"},
            "context_tokens": {"$ref": "#/$defs/positive_integer"}
          }
        },
        "compute_work": {
          "type": "object", "additionalProperties": false,
          "required": ["gflop_per_token", "source"],
          "properties": {
            "gflop_per_token": {"$ref": "#/$defs/positive_number"},
            "source": {"type": "string", "minLength": 1}
          }
        },
        "budgets": {
          "type": "object", "additionalProperties": false,
          "required": ["ram_budget_bytes", "vram_budget_bytes"],
          "properties": {
            "ram_budget_bytes": {"$ref": "#/$defs/non_negative_integer"},
            "vram_budget_bytes": {"$ref": "#/$defs/non_negative_integer"}
          }
        }
      }
    },
    "measurement_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_kind", "profile_id", "document_sha256", "measurement_id"],
      "properties": {
        "profile_kind": {"enum": ["hardware", "model"]},
        "profile_id": {"type": "string", "minLength": 1},
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "measurement_id": {"type": "string", "minLength": 1}
      }
    },
    "candidate_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "placement", "precision_candidate_id", "resources", "estimate", "quality_risk"],
      "properties": {
        "plan_id": {"type": "string", "minLength": 1},
        "placement": {
          "type": "object", "additionalProperties": false,
          "required": ["backend_id", "dense_location", "expert_location"],
          "properties": {
            "backend_id": {"type": "string", "minLength": 1},
            "dense_location": {"enum": ["ram", "vram"]},
            "expert_location": {"enum": ["ram", "vram", "ssd"]}
          }
        },
        "precision_candidate_id": {"type": "string", "minLength": 1},
        "resources": {
          "type": "object", "additionalProperties": false,
          "required": ["ram_bytes", "vram_bytes", "expert_cache_bytes", "max_context_tokens", "disk_bytes_per_token", "startup_seconds"],
          "properties": {
            "ram_bytes": {"$ref": "#/$defs/non_negative_integer"},
            "vram_bytes": {"$ref": "#/$defs/non_negative_integer"},
            "expert_cache_bytes": {"$ref": "#/$defs/non_negative_integer"},
            "max_context_tokens": {"$ref": "#/$defs/non_negative_integer"},
            "disk_bytes_per_token": {"$ref": "#/$defs/non_negative_integer"},
            "startup_seconds": {"type": "number", "minimum": 0}
          }
        },
        "estimate": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "method", "confidence"],
          "properties": {
            "status": {"enum": ["available", "incomplete"]},
            "method": {"const": "analytical-v1"},
            "confidence": {"enum": ["measured_inputs", "partial_inputs", "unsupported"]},
            "prefill_tokens_per_second": {"$ref": "#/$defs/positive_number"},
            "decode_tokens_per_second": {"$ref": "#/$defs/positive_number"},
            "measurement_references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/measurement_reference"}},
            "missing_assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "allOf": [
            {"if": {"properties": {"status": {"const": "available"}}}, "then": {"required": ["prefill_tokens_per_second", "decode_tokens_per_second", "measurement_references"]}},
            {"if": {"properties": {"status": {"const": "incomplete"}}}, "then": {"required": ["missing_assumptions"]}}
          ]
        },
        "quality_risk": {
          "type": "object", "additionalProperties": false,
          "required": ["level", "reference_id"],
          "properties": {
            "level": {"enum": ["none", "unvalidated", "known_degradation"]},
            "reference_id": {"const": "reference-f32-v1"},
            "evidence": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "rejection": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "code", "reason"],
      "properties": {
        "plan_id": {"type": "string", "minLength": 1},
        "code": {"enum": ["ram_budget_exceeded", "vram_budget_exceeded", "context_limit_exceeded", "measurement_unavailable", "backend_unsupported", "precision_insufficient_evidence", "quality_gate_unmet"]},
        "reason": {"type": "string", "minLength": 1},
        "required": {"$ref": "#/$defs/non_negative_integer"},
        "limit": {"$ref": "#/$defs/non_negative_integer"},
        "unit": {"enum": ["bytes", "tokens"]},
        "evidence": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"code": {"enum": ["ram_budget_exceeded", "vram_budget_exceeded", "context_limit_exceeded"]}}}, "then": {"required": ["required", "limit", "unit"]}}
      ]
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "result_id", "request", "candidate_plans", "rejections", "ranking"],
      "properties": {
        "schema": {"const": "colibri-lite-planner-result-v1"},
        "schema_version": {"const": 1},
        "result_id": {"type": "string", "minLength": 1},
        "request": {"$ref": "#/$defs/request"},
        "candidate_plans": {"type": "array", "items": {"$ref": "#/$defs/candidate_plan"}},
        "rejections": {"type": "array", "items": {"$ref": "#/$defs/rejection"}},
        "ranking": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  ]
}
